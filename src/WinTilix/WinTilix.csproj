<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>WinTilix</AssemblyTitle>
    <Product>WinTilix</Product>
    <Description>Windows tiling terminal with synchronized input, inspired by Tilix</Description>
    <VersionPrefix>0.1.8</VersionPrefix>
    <RepositoryUrl>https://github.com/buffalo-analytics/WinTilix</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinTilix.Core\WinTilix.Core.csproj" />
    <ProjectReference Include="..\..\tools\WinTilix.PtyHost\WinTilix.PtyHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Web\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- A runtime-specific build nests PtyHost output under the RID, so resolve both layouts. -->
  <PropertyGroup>
    <PtyHostBuildDir>$(MSBuildThisFileDirectory)..\..\tools\WinTilix.PtyHost\bin\$(Configuration)\net8.0-windows\</PtyHostBuildDir>
    <PtyHostBuildDir Condition="'$(RuntimeIdentifier)' != ''">$(PtyHostBuildDir)$(RuntimeIdentifier)\</PtyHostBuildDir>
  </PropertyGroup>

  <Target Name="CopyPtyHost" AfterTargets="Build">
    <ItemGroup>
      <PtyHostFiles Include="$(PtyHostBuildDir)WinTilix.PtyHost.*" Exclude="$(PtyHostBuildDir)WinTilix.PtyHost.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(PtyHostFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <Error Condition="!Exists('$(TargetDir)WinTilix.PtyHost.exe')"
           Text="WinTilix.PtyHost.exe was not copied from $(PtyHostBuildDir)." />
  </Target>

</Project>
