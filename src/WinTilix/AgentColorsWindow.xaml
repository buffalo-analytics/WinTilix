<Window x:Class="WinTilix.AgentColorsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agent colours"
        Height="420" Width="460"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#1e1e1e"
        Foreground="#e6e6e6">
  <DockPanel Margin="18">
    <TextBlock DockPanel.Dock="Top" FontSize="20" FontWeight="SemiBold" Text="Agent colours"/>
    <TextBlock DockPanel.Dock="Top" Margin="0,8,0,12" Foreground="#9a9a9a" TextWrapping="Wrap"
               Text="The badge and title-bar stripe of a tile take the colour of the agent's role. Enter a hex colour such as #E3B341."/>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Reset to defaults" Width="130" Click="Reset_Click"/>
      <Button Content="Save" Width="90" Margin="8,0,0,0" IsDefault="True" Click="Save_Click"/>
      <Button Content="Cancel" Width="90" Margin="8,0,0,0" IsCancel="True"/>
    </StackPanel>

    <StackPanel x:Name="Rows"/>
  </DockPanel>
</Window>
