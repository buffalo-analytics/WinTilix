<Window x:Class="WinTilix.ClusterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSH clusters"
        Height="560" Width="760"
        WindowStartupLocation="CenterOwner"
        Background="#1e1e1e"
        Foreground="#e6e6e6">
  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,12"
               Text="Create named clusters of SSH hosts, then open one into a new workspace tab."/>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Cancel" Width="90" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
      <Button Content="Save" Width="90" Margin="0,0,8,0" Click="Save_Click"/>
      <Button Content="Open cluster" Width="120" IsDefault="True" Click="Open_Click"/>
    </StackPanel>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <DockPanel Grid.Column="0">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
          <Button Content="New" Width="70" Margin="0,0,8,0" Click="NewCluster_Click"/>
          <Button Content="Delete" Width="70" Click="DeleteCluster_Click"/>
        </StackPanel>
        <ListBox x:Name="ClusterList"
                 Background="#141414"
                 BorderBrush="#3a3a3a"
                 BorderThickness="1"
                 Foreground="#e6e6e6"
                 DisplayMemberPath="Name"
                 SelectionChanged="ClusterList_SelectionChanged">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="8,5"/>
              <Setter Property="Foreground" Value="#e6e6e6"/>
              <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                  <Setter Property="Background" Value="#365f5b"/>
                  <Setter Property="Foreground" Value="White"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </ListBox.ItemContainerStyle>
        </ListBox>
      </DockPanel>

      <Border Grid.Column="2" Background="#141414" BorderBrush="#3a3a3a" BorderThickness="1" CornerRadius="3" Padding="12">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Cluster name" Foreground="#9a9a9a" Margin="0,0,0,4"/>
            <TextBox x:Name="ClusterNameBox" Style="{StaticResource DarkTextBox}" Height="30" Margin="0,0,0,12"/>

            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ComboBox x:Name="HostPicker"
                        Style="{StaticResource DarkComboBox}"
                        Height="28"
                        ToolTip="Choose an SSH config alias"
                        SelectionChanged="HostPicker_SelectionChanged"/>
              <TextBox x:Name="CustomHostBox"
                       Grid.Column="1"
                       Width="160"
                       Height="28"
                       Margin="8,0,0,0"
                       Style="{StaticResource DarkTextBox}"
                       ToolTip="Or type user@host / hostname"
                       KeyDown="CustomHostBox_KeyDown"/>
              <Button x:Name="AddButton"
                      Grid.Column="2"
                      Content="+"
                      Width="36"
                      Height="28"
                      Margin="8,0,0,0"
                      FontSize="16"
                      FontWeight="Bold"
                      ToolTip="Add host to the cluster"
                      Click="Add_Click"/>
            </Grid>
          </StackPanel>

          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
              <Button DockPanel.Dock="Right"
                      Content="Clear"
                      Padding="8,2"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="#9a9a9a"
                      Click="Clear_Click"/>
              <TextBlock Foreground="#9a9a9a" VerticalAlignment="Center"
                         Text="Hosts in this cluster"/>
            </DockPanel>
            <ListBox x:Name="SelectedHosts"
                     Background="#111111"
                     BorderBrush="#3a3a3a"
                     BorderThickness="1"
                     Foreground="#e6e6e6"
                     Padding="4">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Background" Value="Transparent"/>
                  <Setter Property="Foreground" Value="#e6e6e6"/>
                  <Setter Property="Padding" Value="2"/>
                  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="2,2">
                    <Button DockPanel.Dock="Right"
                            Content="✕"
                            Width="28"
                            Height="22"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#cccccc"
                            ToolTip="Remove host"
                            Click="RemoveHost_Click"
                            Tag="{Binding}"/>
                    <TextBlock Text="{Binding}" VerticalAlignment="Center" Margin="4,0"/>
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
