<Window x:Class="WinTilix.ClusterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSH cluster"
        Height="420" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="#1e1e1e"
        Foreground="#e6e6e6">
  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,12"
               Text="One SSH target per line (user@host). WinTilix opens a tiled pane for each host and turns on synchronized input, like Tilix + CSSH."/>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Cancel" Width="90" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
      <Button Content="Open cluster" Width="120" IsDefault="True" Click="Open_Click"/>
    </StackPanel>
    <TextBox x:Name="HostsBox" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
             FontFamily="Consolas" Background="#141414" Foreground="#e6e6e6" BorderBrush="#3a3a3a"
             Text="user@server-1&#x0a;user@server-2&#x0a;user@server-3"/>
  </DockPanel>
</Window>
