<Window x:Class="WinTilix.ClusterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSH cluster"
        Height="520" Width="560"
        WindowStartupLocation="CenterOwner"
        Background="#1e1e1e"
        Foreground="#e6e6e6">
  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,12"
               Text="Pick aliases from ~/.ssh/config (or type a host), press + to add each one, then open the cluster. The host list is saved for next time."/>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Cancel" Width="90" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
      <Button Content="Open cluster" Width="120" IsDefault="True" Click="Open_Click"/>
    </StackPanel>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <ComboBox x:Name="HostPicker"
                  Style="{StaticResource DarkComboBox}"
                  Height="28"
                  ToolTip="Choose an SSH config alias"
                  SelectionChanged="HostPicker_SelectionChanged"/>
        <TextBox x:Name="CustomHostBox"
                 Grid.Column="1"
                 Width="180"
                 Height="28"
                 Margin="8,0,0,0"
                 Padding="8,4"
                 VerticalContentAlignment="Center"
                 Background="#2a2a2a"
                 Foreground="#d8d8d8"
                 BorderBrush="#454545"
                 CaretBrush="#d8d8d8"
                 ToolTip="Or type user@host / hostname"
                 KeyDown="CustomHostBox_KeyDown"/>
        <Button x:Name="AddButton"
                Grid.Column="2"
                Content="+"
                Width="36"
                Height="28"
                Margin="8,0,0,0"
                FontSize="16"
                FontWeight="Bold"
                ToolTip="Add host to the cluster"
                Click="Add_Click"/>
      </Grid>

      <Border Grid.Row="1" Background="#141414" BorderBrush="#3a3a3a" BorderThickness="1" CornerRadius="3">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="8,6,8,4">
            <Button DockPanel.Dock="Right"
                    Content="Clear"
                    Padding="8,2"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#9a9a9a"
                    Click="Clear_Click"/>
            <TextBlock Foreground="#9a9a9a" VerticalAlignment="Center"
                       Text="Hosts in this cluster"/>
          </DockPanel>
          <ListBox x:Name="SelectedHosts"
                   Background="Transparent"
                   BorderThickness="0"
                   Foreground="#e6e6e6"
                   Padding="4">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#e6e6e6"/>
                <Setter Property="Padding" Value="2"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="2,2">
                  <Button DockPanel.Dock="Right"
                          Content="✕"
                          Width="28"
                          Height="22"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="#cccccc"
                          ToolTip="Remove host"
                          Click="RemoveHost_Click"
                          Tag="{Binding}"/>
                  <TextBlock Text="{Binding}" VerticalAlignment="Center" Margin="4,0"/>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <TextBlock Grid.Row="2" Margin="0,8,0,0" Foreground="#7a7a7a" FontSize="12"
                 Text="Tip: Enter in the host box also adds it. Synchronized input turns on when the cluster opens."/>
    </Grid>
  </DockPanel>
</Window>
