<UserControl x:Class="WinTilix.Controls.TerminalPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
  <Border BorderBrush="#2b2b2b" BorderThickness="0,0,1,1" Background="#1c1c1c">
    <DockPanel>
      <Border x:Name="TitleBar" DockPanel.Dock="Top" Background="#252525" Padding="8,4">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button x:Name="SyncButton" Click="SyncButton_Click" Width="28" Height="22" Margin="0,0,4,0"
                    ToolTip="Include this pane in synchronized input" Background="Transparent" BorderThickness="0" Foreground="#9adbd6">
              <TextBlock Text="⌨" FontSize="13"/>
            </Button>
            <Button Click="SplitRight_Click" Width="28" Height="22" Margin="0,0,2,0"
                    ToolTip="Split right (Ctrl+Shift+E)" Background="Transparent" BorderThickness="0" Foreground="#cccccc" Content="⫿"/>
            <Button Click="SplitDown_Click" Width="28" Height="22" Margin="0,0,2,0"
                    ToolTip="Split down (Ctrl+Shift+O)" Background="Transparent" BorderThickness="0" Foreground="#cccccc" Content="☰"/>
            <Button Click="Close_Click" Width="28" Height="22"
                    ToolTip="Close pane (Ctrl+Shift+W)" Background="Transparent" BorderThickness="0" Foreground="#cccccc" Content="✕"/>
          </StackPanel>
          <Border x:Name="ConnectionHealthBadge" DockPanel.Dock="Right"
                  Visibility="Collapsed" CornerRadius="9" Margin="8,1,8,1" Padding="7,1">
            <TextBlock x:Name="ConnectionHealthText" FontSize="11" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
          </Border>
          <ComboBox x:Name="SessionSelector"
                    Style="{StaticResource DarkComboBox}"
                    MinWidth="170" MaxWidth="300" Height="24"
                    VerticalAlignment="Center" HorizontalAlignment="Left"
                    MaxDropDownHeight="320"
                    TextSearch.TextPath="Label"
                    ToolTip="Choose the local shell or an alias from ~/.ssh/config"
                    DropDownOpened="SessionSelector_DropDownOpened"
                    SelectionChanged="SessionSelector_SelectionChanged"
                    PreviewKeyDown="SessionSelector_PreviewKeyDown">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
              </DataTemplate>
            </ComboBox.ItemTemplate>
            <ComboBox.ItemContainerStyle>
              <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DarkComboBoxItem}">
                <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
              </Style>
            </ComboBox.ItemContainerStyle>
          </ComboBox>
        </DockPanel>
      </Border>
      <wv2:WebView2 x:Name="WebView" DefaultBackgroundColor="#1C1C1C"/>
    </DockPanel>
  </Border>
</UserControl>
