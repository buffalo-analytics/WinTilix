<Window x:Class="WinTilix.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinTilix updates"
        Height="340" Width="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#1e1e1e"
        Foreground="#e6e6e6">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Text="WinTilix updates" FontSize="22" FontWeight="SemiBold"/>

    <Grid Grid.Row="1" Margin="0,18,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Text="Installed version" Foreground="#a8a8a8" Margin="0,0,18,8"/>
      <TextBlock x:Name="CurrentVersionText" Grid.Column="1" FontWeight="SemiBold"/>
      <TextBlock Grid.Row="1" Text="Latest release" Foreground="#a8a8a8" Margin="0,0,18,0"/>
      <TextBlock x:Name="LatestVersionText" Grid.Row="1" Grid.Column="1" FontWeight="SemiBold"/>
    </Grid>

    <Border Grid.Row="2" Margin="0,18,0,16" Padding="12"
            Background="#171717" BorderBrush="#353535" BorderThickness="1" CornerRadius="4">
      <StackPanel VerticalAlignment="Center">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap"/>
        <ProgressBar x:Name="DownloadProgress" Height="8" Margin="0,12,0,0"
                     Minimum="0" Maximum="100" Visibility="Collapsed"
                     Background="#2a2a2a" Foreground="#62b8b0"/>
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="CloseButton" Content="Close" Width="90" IsCancel="True"/>
      <Button x:Name="ReleaseButton" Content="View release" Width="110" Margin="8,0,0,0"
              Click="ReleaseButton_Click"/>
      <Button x:Name="InstallButton" Content="Download and install" Width="150" Margin="8,0,0,0"
              Click="InstallButton_Click"/>
    </StackPanel>
  </Grid>
</Window>
